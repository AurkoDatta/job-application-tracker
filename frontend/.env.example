# Currently unused — the Vite dev server proxy (see vite.config.js) routes
# /api requests to the backend, so no base URL is needed in development.
# Established here as the pattern for future frontend env vars (e.g. a
# production API base URL once the app is deployed somewhere other than
# behind the same origin as the backend).
# VITE_API_BASE_URL=http://localhost:8080
